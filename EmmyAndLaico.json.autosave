my","PlatformerObject"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["vida","-","1"]},{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["Emmy","Effect","\"ColorMap\"","yes"]},{"type":{"value":"ActivateBehavior"},"parameters":["Emmy","PlatformerObject",""]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::PauseAnimation"},"parameters":["Emmy","Animation"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Wait"},"parameters":["0.5"]},{"type":{"value":"SetXY"},"parameters":["Emmy","=","PosicionInicial.X()","=","PosicionInicial.Y()"]},{"type":{"value":"ActivateBehavior"},"parameters":["Emmy","PlatformerObject","yes"]},{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["Emmy","Effect","\"ColorMap\"","no"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::PlayAnimation"},"parameters":["Emmy","Animation"]}]}]}]}]},{"associatedLayout":"Nivel04","name":"LevitadoraWaiting","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["LevitadoraWaiting","Emmy","","",""]}],"actions":[{"type":{"value":"SetCenterY"},"parameters":["LevitadoraWaiting","-","LevitadoraWaiting.Velocidad"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]}]}],"externalEventsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Personaje"},{"itemName":"Camara bg"},{"itemName":"Plataforma Levitadora"},{"itemName":"PlataformaDebil"},{"itemName":"PlataformaTrampolin"},{"itemName":"EnemigoEsqueleto"},{"itemName":"LevitadoraWaiting"}]},"tests":[{"description":"Verificar texto y posicion del dialogo","lastRunAt":1794109120840.0,"lastRunDurationMs":356.0,"lastRunFramesExecuted":54,"lastRunStatus":"failed","name":"dialogo-emmy-marisol","type":"gameplay","source":["await harness.goToScene('Nivel04');","await harness.stepFrames(30);","const m = harness.getObjects('Marisol')[0];","// Mover la Emmy original junto a Marisol en vez de spawnear otra","const e = harness.getObjects('Emmy')[0];","harness.setObjectPosition(e.id, m.centerX + 30, m.centerY, 0);","await harness.stepFrames(5);","const near = harness.getNearby('Emmy', 'Marisol', 200)[0];","harness.assert(!!near && near.distance < 100, 'Emmy cerca de Marisol dist=' + (near?near.distance.toFixed(1):'none'));","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(15);","const boxes = harness.getObjects('DialogueBox');","const texts = harness.getObjects('DialogueText');","harness.assert(boxes.length>0, 'Box creado: '+boxes.length);","harness.assert(texts.length>0, 'Text creado: '+texts.length);","if (texts.length>0) { console.log('TEXTO: ['+texts[0].text+']'); harness.assert((texts[0].text||'').includes('Marisol'), 'Texto es la linea 1 del dialogo: \"'+(texts[0].text||'')+'\"'); }","if (boxes.length>0) { console.log('BOX x='+boxes[0].centerX+' y='+boxes[0].centerY+' layer='+boxes[0].layer); }","const cam = harness.getCameraState('Dialogue');","console.log('CAM Dialogue: '+JSON.stringify(cam));","await harness.takeScreenshot('dialogo-2');"]},{"description":"Volcar variables y texto final del dialogo","lastRunAt":1794109192582.0,"lastRunDurationMs":487.0,"lastRunFramesExecuted":344,"lastRunStatus":"passed","name":"dialogo-debug","type":"gameplay","source":["await harness.goToScene('Nivel04');","await harness.stepFrames(30);","const m = harness.getObjects('Marisol')[0];","const e = harness.getObjects('Emmy')[0];","harness.setObjectPosition(e.id, m.centerX + 30, m.centerY, 0);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","const mv = harness.getObjectVariable(m.id, 'Dialogue[0]');","console.log('VAR Dialogue[0]: ' + JSON.stringify(mv));","const mvAll = harness.getObjectVariable(m.id, 'Dialogue');","console.log('VAR Dialogue: ' + JSON.stringify(mvAll));","const cv = harness.getObjectVariable(m.id, 'CurrentLine');","console.log('CurrentLine: ' + JSON.stringify(cv));","await harness.stepFrames(300);","const texts = harness.getObjects('DialogueText');","console.log('TEXTO FINAL: [' + (texts[0] ? texts[0].text : 'none') + ']');","await harness.takeScreenshot('dialogo-final');"]},{"description":"Flujo completo del dialogo: abrir, primera linea, avanzar y cerrar","lastRunAt":1794109294380.0,"lastRunDurationMs":473.0,"lastRunFramesExecuted":314,"lastRunStatus":"passed","name":"dialogo-flujo-completo","type":"gameplay","source":["await harness.goToScene('Nivel04');","await harness.stepFrames(30);","const m = harness.getObjects('Marisol')[0];","const e = harness.getObjects('Emmy')[0];","harness.setObjectPosition(e.id, m.centerX + 30, m.centerY, 0);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(60);","let texts = harness.getObjects('DialogueText');","harness.assert(texts.length>0, 'Dialogo abierto con E');","if (texts.length>0) harness.assert((texts[0].text||'').includes('Marisol'), 'Primera linea es de Marisol (no avanza sola): \"'+(texts[0].text||'')+'\"');","await harness.takeScreenshot('linea-1');","// Avanzar con Espacio hasta el final (5 lineas)","for (let i=0;i<5;i++) {","  harness.setKeyPressed('Space', true);","  await harness.stepFrames(3);","  harness.setKeyPressed('Space', false);","  await harness.stepFrames(40);","}","texts = harness.getObjects('DialogueText');","harness.assert(texts.length===0, 'Dialogo cerrado tras avanzar todas las lineas (quedan '+texts.length+')');","await harness.takeScreenshot('dialogo-cerrado');"]},{"description":"Captura final del dialogo centrado","lastRunAt":1794109431304.0,"lastRunDurationMs":532.0,"lastRunFramesExecuted":239,"lastRunStatus":"passed","name":"dialogo-visible","type":"gameplay","source":["await harness.goToScene('Nivel04');","await harness.stepFrames(30);","const m = harness.getObjects('Marisol')[0];","const e = harness.getObjects('Emmy')[0];","harness.setObjectPosition(e.id, m.centerX + 30, m.centerY, 0);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(200);","await harness.takeScreenshot('dialogo-centrado');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"dialogo-emmy-marisol"},{"itemName":"dialogo-debug"},{"itemName":"dialogo-flujo-completo"},{"itemName":"dialogo-visible"}]},"eventsFunctionsExtensions":[{"author":"westboy, daliyoucefmedakram@gmail.com, @bouh","category":"User interface","dimension":"","extensionNamespace":"","fullName":"Auto typing animation for text (\"typewriter\" effect)","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"AutoTyping","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/typewriter.svg","shortDescription":"Typewriter text reveal effect, one letter at a time. For Text/BitmapText objects.","version":"2.2.0","description":["Reveal a text one letter after the other (a \"typewriter\" effect).","","It can be used for dialogue scenes or visual novels on Text and Bitmap Text objects.","","The top-down RPG example uses this extension ([open the project online](https://editor.gdevelop.io/?project=example://top-down-rpg))."],"origin":{"identifier":"AutoTyping","name":"gdevelop-extension-store"},"tags":["text","bbtext","dialogue","visual novel","autotyping","bitmap"],"authorIds":["2OwwM8ToR9dx9RJ2sAKTcrLmCB92","gqDaZjCfevOOxBYkK6zlhtZnXCg1","IWykYNRvhCZBN3vEgKEbBPOR3Oc2"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Reveal a text one letter after the other.","fullName":"Auto typing text","helpPath":"","icon